{
  "name": "memento-mori-jester",
  "version": "0.1.66",
  "description": "A local court-jester sidecar for AI coding agents: review plans, commands, diffs, and final claims before they get too pleased with themselves.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Martin123132/Memento-Mori.git"
  },
  "homepage": "https://github.com/Martin123132/Memento-Mori#readme",
  "bugs": {
    "url": "https://github.com/Martin123132/Memento-Mori/issues"
  },
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "bin": {
    "jester": "dist/cli.js",
    "memento-mori-jester": "dist/cli.js",
    "memento-mori-jester-mcp": "dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "docs",
    "examples",
    "scripts",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/server.js",
    "test": "npm run build && node scripts/run-tests.mjs && npm run fixtures:check && npm run fixtures:report && npm run production:check",
    "doctor": "node dist/cli.js doctor",
    "demo:svg": "node scripts/render-demo-svg.mjs",
    "demo:svg:check": "node scripts/render-demo-svg.mjs --check",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "fixtures:report": "node scripts/report-fixtures.mjs",
    "production:check": "node scripts/check-production-readiness.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run pack:dry"
  },
  "keywords": [
    "mcp",
    "ai-agent",
    "coding-agent",
    "safety",
    "cli",
    "code-review",
    "memento-mori",
    "court-jester"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE"
}
